# Maximum Independent Set Decoder
#
# Input:
#   0: BSMX sample
#   1: N (vertex count)
#
# Output:
#   0: selected vertices (vec<int>)

PUSH 0
INPUT r0
PUSH 1
INPUT r1

VECI r2
PUSH 0
LOAD r1
RANGE
  LVAL r10
  LOAD r10
  GETLINE r0
  PUSH 1
  EQ
  NOT
  JUMPI .0
  LOAD r10
  VECPUSH r2
  TARGET .0
NEXT

PUSH 0
OUTPUT r2
HALT
