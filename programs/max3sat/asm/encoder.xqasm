# Max-3-SAT Encoder
#
# Encodes a Max-3-SAT problem into a QUBO model using degree reduction.
#
# Each clause (l1 OR l2 OR l3) contributes a cubic penalty
# P * (1-l1)(1-l2)(1-l3) that is reduced to quadratic terms
# using one auxiliary variable per clause.
#
# For literal li:
#   If positive (xi):  complement (1-li) = (1-xi), coeff=-1, const=1
#   If negated (NOT xi): complement (1-li) = xi,   coeff=1,  const=0
#
# Degree reduction: for cubic term xa*xb*xc, introduce w = xa*xb
#   Auxiliary constraint: P_aux * (xa*xb - 2*xa*w - 2*xb*w + 3*w)
#   Cubic term becomes: w*xc (quadratic)
#
# Input:
#   0: N (int, variable count)
#   1: M (int, clause count)
#   2: clauses (vec<int>, flat triples [var, neg, var, neg, var, neg, ...])
#      neg: 0 = positive literal, 1 = negated literal
#   3: P (int, clause penalty weight)
#   4: P_aux (int, auxiliary constraint penalty, must be >> P)
#
# Output:
#   0: BQMX model (N + M variables)

# === Read inputs ===
PUSH 0
INPUT r0
PUSH 1
INPUT r1
PUSH 2
INPUT r2
PUSH 3
INPUT r3
PUSH 4
INPUT r4

# === Total vars = N + M ===
LOAD r0
LOAD r1
ADD
STOW r6

# === Allocate model ===
LOAD r6
BQMX r5

# === For each clause ===
PUSH 0
LOAD r1
RANGE
  LVAL r10

  # offset = c * 6
  LOAD r10
  PUSH 6
  MUL
  STOW r11

  # Read literal 0: var, neg
  LOAD r11
  VECGET r2
  STOW r12
  LOAD r11
  INC
  VECGET r2
  STOW r15

  # Read literal 1: var, neg
  LOAD r11
  PUSH 2
  ADD
  VECGET r2
  STOW r13
  LOAD r11
  PUSH 3
  ADD
  VECGET r2
  STOW r16

  # Read literal 2: var, neg
  LOAD r11
  PUSH 4
  ADD
  VECGET r2
  STOW r14
  LOAD r11
  PUSH 5
  ADD
  VECGET r2
  STOW r17

  # Compute complement coefficients and constants
  # neg=1: coeff=1, const=0  |  neg=0: coeff=-1, const=1

  # Literal a
  LOAD r15
  PUSH 1
  EQ
  NOT
  JUMPI .0
  PUSH 1
  STOW r18
  PUSH 0
  STOW r21
  JUMP .1
  TARGET .0
  PUSH -1
  STOW r18
  PUSH 1
  STOW r21
  TARGET .1

  # Literal b
  LOAD r16
  PUSH 1
  EQ
  NOT
  JUMPI .2
  PUSH 1
  STOW r19
  PUSH 0
  STOW r22
  JUMP .3
  TARGET .2
  PUSH -1
  STOW r19
  PUSH 1
  STOW r22
  TARGET .3

  # Literal c
  LOAD r17
  PUSH 1
  EQ
  NOT
  JUMPI .4
  PUSH 1
  STOW r20
  PUSH 0
  STOW r23
  JUMP .5
  TARGET .4
  PUSH -1
  STOW r20
  PUSH 1
  STOW r23
  TARGET .5

  # Auxiliary variable: w = N + clause_index
  LOAD r0
  LOAD r10
  ADD
  STOW r24

  # Intermediate products for (a_coeff*xa + a_const)(b_coeff*xb + b_const)
  LOAD r18
  LOAD r19
  MUL
  STOW r25            # ab_xy = a_coeff * b_coeff

  LOAD r18
  LOAD r22
  MUL
  STOW r26            # ab_x = a_coeff * b_const

  LOAD r19
  LOAD r21
  MUL
  STOW r27            # ab_y = b_coeff * a_const

  LOAD r21
  LOAD r22
  MUL
  STOW r28            # ab_c = a_const * b_const

  # === QUBO terms from clause penalty ===

  # Linear xa: P * ab_x * c_const
  LOAD r12
  LOAD r3
  LOAD r26
  MUL
  LOAD r23
  MUL
  ADDLINE r5

  # Linear xb: P * ab_y * c_const
  LOAD r13
  LOAD r3
  LOAD r27
  MUL
  LOAD r23
  MUL
  ADDLINE r5

  # Linear xc: P * ab_c * c_coeff
  LOAD r14
  LOAD r3
  LOAD r28
  MUL
  LOAD r20
  MUL
  ADDLINE r5

  # Quadratic xa*xb: P * ab_xy * c_const
  LOAD r12
  LOAD r13
  LOAD r3
  LOAD r25
  MUL
  LOAD r23
  MUL
  ADDQUAD r5

  # Quadratic xa*xc: P * ab_x * c_coeff
  LOAD r12
  LOAD r14
  LOAD r3
  LOAD r26
  MUL
  LOAD r20
  MUL
  ADDQUAD r5

  # Quadratic xb*xc: P * ab_y * c_coeff
  LOAD r13
  LOAD r14
  LOAD r3
  LOAD r27
  MUL
  LOAD r20
  MUL
  ADDQUAD r5

  # Quadratic w*xc: P * ab_xy * c_coeff (reduced cubic)
  LOAD r24
  LOAD r14
  LOAD r3
  LOAD r25
  MUL
  LOAD r20
  MUL
  ADDQUAD r5

  # === Auxiliary constraint: P_aux * (xa*xb - 2*xa*w - 2*xb*w + 3*w) ===

  # Quadratic xa*xb: P_aux
  LOAD r12
  LOAD r13
  LOAD r4
  ADDQUAD r5

  # Quadratic xa*w: P_aux * (-2)
  LOAD r12
  LOAD r24
  LOAD r4
  PUSH -2
  MUL
  ADDQUAD r5

  # Quadratic xb*w: P_aux * (-2)
  LOAD r13
  LOAD r24
  LOAD r4
  PUSH -2
  MUL
  ADDQUAD r5

  # Linear w: P_aux * 3
  LOAD r24
  LOAD r4
  PUSH 3
  MUL
  ADDLINE r5

NEXT

# === Output model ===
PUSH 0
OUTPUT r5
HALT
