# Set Cover Encoder (using ATLEAST)
#
# ATLEAST handles the slack variable generation internally.
# For each element, just build the coverage group vec and call ATLEAST 1.
#
# Input:
#   0: N (int, universe size)
#   1: M (int, number of subsets)
#   2: coverage (vec<int>, flat: [count, idx, idx, ..., count, idx, ...])
#   3: A (int, subset cost weight)
#   4: P (int, coverage penalty)
#
# Output:
#   0: BQMX model

# === Read inputs ===
PUSH 0
INPUT r0
PUSH 1
INPUT r1
PUSH 2
INPUT r2
PUSH 3
INPUT r3
PUSH 4
INPUT r4

# === Allocate model ===
# ATLEAST will extend model.size internally when adding slacks
# Start with M variables
LOAD r1
BQMX r12              # model

# === Objective: A * x_j for each subset ===
PUSH 0
LOAD r1
RANGE
  LVAL r10
  LOAD r10
  LOAD r3
  ADDLINE r12
NEXT

# === Coverage constraints ===
PUSH 0
STOW r5               # offset

PUSH 0
LOAD r0
RANGE
  LVAL r10

  LOAD r5
  VECGET r2
  STOW r8             # group_size

  # Build group vec with subset indices
  VECI r14
  PUSH 0
  LOAD r8
  RANGE
    LVAL r16
    LOAD r5
    INC
    LOAD r16
    ADD
    VECGET r2          # subset_idx
    VECPUSH r14
  NEXT

  # ATLEAST 1 with penalty P
  LOAD r4             # P
  PUSH 1              # k = 1
  ATLEAST r12 r14

  # Advance offset
  LOAD r5
  INC
  LOAD r8
  ADD
  STOW r5
NEXT

# === Output ===
PUSH 0
OUTPUT r12
HALT
