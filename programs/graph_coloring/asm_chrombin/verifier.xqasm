# Graph Coloring Verifier — Binary (CHROMBIN) encoding
#
# Input:
#   0: BQMX model
#   1: BSMX sample
#   2: N (vertex count)
#   3: E (edge count)
#   4: edges (vec<int>)
#
# Output:
#   0: energy
#   1: valid (no adjacent same color)
#   2: conflicts

PUSH 0
INPUT r0
PUSH 1
INPUT r1
PUSH 2
INPUT r2
PUSH 3
INPUT r3
PUSH 4
INPUT r4

PUSH 1
STOW r5               # valid = 1
PUSH 0
STOW r6               # conflicts = 0

# Check each edge
PUSH 0
LOAD r3
RANGE
  LVAL r10

  LOAD r10
  PUSH 2
  MUL
  STOW r7

  LOAD r7
  VECGET r4
  STOW r8             # vertex i

  LOAD r7
  INC
  VECGET r4
  STOW r9             # vertex j

  # Decode colors from binary bits
  # color_i = bit0(i) + 2*bit1(i)
  LOAD r8
  PUSH 2
  MUL
  GETLINE r1          # bit0 of i
  STOW r11

  LOAD r8
  PUSH 2
  MUL
  INC
  GETLINE r1          # bit1 of i
  PUSH 2
  MUL
  LOAD r11
  ADD
  STOW r11            # color_i

  LOAD r9
  PUSH 2
  MUL
  GETLINE r1          # bit0 of j
  STOW r12

  LOAD r9
  PUSH 2
  MUL
  INC
  GETLINE r1          # bit1 of j
  PUSH 2
  MUL
  LOAD r12
  ADD
  STOW r12            # color_j

  # Same color?
  LOAD r11
  LOAD r12
  EQ
  NOT
  JUMPI .0
  LOAD r6
  INC
  STOW r6
  TARGET .0
NEXT

LOAD r6
PUSH 0
EQ
LOAD r5
AND
STOW r5

ENERGY r0 r1
STOW r13

PUSH 0
OUTPUT r13
PUSH 1
OUTPUT r5
PUSH 2
OUTPUT r6
HALT
