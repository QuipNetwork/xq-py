# Set Cover Verifier
#
# Input:
#   0: BQMX model
#   1: BSMX sample
#   2: N (universe size)
#   3: M (number of subsets)
#   4: coverage vec
#
# Output:
#   0: energy
#   1: valid (all binary)
#   2: subsets_selected (count)
#   3: elements_covered (count)

# === Load inputs ===
PUSH 0
INPUT r0
PUSH 1
INPUT r1
PUSH 2
INPUT r2
PUSH 3
INPUT r3
PUSH 4
INPUT r4

# === Initialize ===
PUSH 1
STOW r5               # valid = 1
PUSH 0
STOW r6               # subsets_selected = 0
PUSH 0
STOW r7               # elements_covered = 0

# === Check binary + count selected subsets ===
# Only check original M variables for selection count
PUSH 0
LOAD r3
RANGE
  LVAL r10
  LOAD r10
  GETLINE r1
  STOW r8

  # Check binary
  LOAD r8
  PUSH 0
  EQ
  LOAD r8
  PUSH 1
  EQ
  OR
  LOAD r5
  AND
  STOW r5

  # Count selected
  LOAD r8
  LOAD r6
  ADD
  STOW r6
NEXT

# === Check coverage: for each element, at least one covering subset selected ===
PUSH 0
STOW r9               # offset

PUSH 0
LOAD r2
RANGE
  LVAL r10

  LOAD r9
  VECGET r4
  STOW r8             # group_size

  # Check if any subset in group is selected
  PUSH 0
  STOW r11            # covered = 0

  PUSH 0
  LOAD r8
  RANGE
    LVAL r16
    LOAD r9
    INC
    LOAD r16
    ADD
    VECGET r4          # subset_idx
    GETLINE r1         # sample[subset_idx]
    LOAD r11
    ADD
    STOW r11           # covered += sample[subset_idx]
  NEXT

  # If covered >= 1, element is covered
  LOAD r11
  PUSH 1
  GTE
  LOAD r7
  ADD
  STOW r7

  # Advance offset
  LOAD r9
  INC
  LOAD r8
  ADD
  STOW r9
NEXT

# === Energy ===
ENERGY r0 r1
STOW r12

# === Output ===
PUSH 0
OUTPUT r12
PUSH 1
OUTPUT r5
PUSH 2
OUTPUT r6
PUSH 3
OUTPUT r7
HALT
